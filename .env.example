# ----------------------------------------------------------------------------
# LexBoard environment variables. Copy to .env.local and fill in real values.
# ----------------------------------------------------------------------------

# App URL (used by NextAuth and Stripe redirects)
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Auth.js v5 — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# Optional: key used to encrypt stored BYOK provider API keys (AES-256-GCM).
# Falls back to AUTH_SECRET if unset. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Google OAuth (https://console.cloud.google.com -> Credentials -> OAuth client)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings -> API -> JWT Settings -> JWT Secret (used to sign RLS tokens)
SUPABASE_JWT_SECRET=

# Chat LLM — Google Gemini, free tier (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Embeddings — Voyage AI, free tier (https://www.voyageai.com) — legal-domain model
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-law-2

# Email — Resend (https://resend.com), optional. Without it, invites fall back
# to the copyable link. Set EMAIL_FROM to an address on a verified domain to
# email real invitees (the default only delivers to your own Resend account).
RESEND_API_KEY=
EMAIL_FROM=LexBoard <onboarding@resend.dev>

# Stripe (https://dashboard.stripe.com)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_SOLO=
NEXT_PUBLIC_STRIPE_PRICE_FIRM=
